<?xml version="1.0"?>
<robot name="robot_dog">

  <material name="base_color"><color rgba="0.2 0.2 0.2 1.0"/></material>
  <material name="hip_color"><color rgba="0.4 0.4 0.4 1.0"/></material>
  <material name="thigh_color"><color rgba="0.8 0.1 0.1 1.0"/></material>
  <material name="shank_color"><color rgba="0.1 0.4 0.8 1.0"/></material>

  <link name="base_link">
    <visual>
      <geometry><box size="0.3 0.12 0.45"/></geometry>
      <material name="base_color"/>
    </visual>
    <collision>
      <geometry><box size="0.3 0.12 0.45"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
  </link>

  <!-- FL -->
  <joint name="FL_hip_yaw" type="revolute">
    <parent link="base_link"/>
    <child link="FL_hip_solid"/>
    <origin xyz="-0.15 0 -0.225" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="10" lower="-3.14" upper="3.14"/>
  </joint>
  <link name="FL_hip_solid">
    <visual>
      <origin xyz="-0.04 0 0" rpy="0 0 0"/>
      <geometry><box size="0.08 0.05 0.05"/></geometry>
      <material name="hip_color"/>
    </visual>
    <collision>
      <origin xyz="-0.04 0 0" rpy="0 0 0"/>
      <geometry><box size="0.08 0.05 0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="FL_hip_pitch" type="revolute">
    <parent link="FL_hip_solid"/>
    <child link="FL_thigh_solid"/>
    <origin xyz="-0.08 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="100" velocity="10" lower="-3.14" upper="3.14"/>
  </joint>
  <link name="FL_thigh_solid">
    <visual>
      <origin xyz="0 -0.1 0" rpy="0 0 0"/>
      <geometry><box size="0.04 0.2 0.04"/></geometry>
      <material name="thigh_color"/>
    </visual>
    <collision>
      <origin xyz="0 -0.1 0" rpy="0 0 0"/>
      <geometry><box size="0.04 0.2 0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.12"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="FL_knee_pitch" type="revolute">
    <parent link="FL_thigh_solid"/>
    <child link="FL_shank_solid"/>
    <origin xyz="0 -0.2 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="100" velocity="10" lower="-3.14" upper="3.14"/>
  </joint>
  <link name="FL_shank_solid">
    <visual>
      <origin xyz="0 -0.1 0" rpy="0 0 0"/>
      <geometry><box size="0.03 0.2 0.03"/></geometry>
      <material name="shank_color"/>
    </visual>
    <collision>
      <origin xyz="0 -0.1 0" rpy="0 0 0"/>
      <geometry><box size="0.03 0.2 0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

